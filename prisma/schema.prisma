generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RegistrationType {
  INDIVIDUAL
  INSTITUTION
}

model Waitlist {
  id        String           @id @default(cuid())
  email     String           @unique
  type      RegistrationType
  createdAt DateTime         @default(now())
}
